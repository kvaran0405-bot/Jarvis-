# --- Required for the agents to think ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- About you -------------------------------------------------------------
JARVIS_OWNER_NAME=Sir
JARVIS_TIMEZONE=Africa/Lagos          # any IANA zone, e.g. Europe/London, America/New_York

# --- Engine ----------------------------------------------------------------
JARVIS_MODEL=claude-opus-5-5
JARVIS_PORT=7334
JARVIS_SCHEDULER=on                   # off = no automatic jobs

# --- Daily routine (24h, local time) -----------------------------------------
JARVIS_MORNING_AT=07:00
JARVIS_EVENING_AT=21:00
JARVIS_NIGHT_SHIFT_AT=02:00
JARVIS_WEEKLY_AT=18:00                # Sundays
JARVIS_WATCH_EVERY_HOURS=3

# --- Optional: get reports by e-mail -----------------------------------------
# For Gmail use an App Password (Google Account > Security > App passwords)
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_REPORT_EMAIL_TO=

# --- Optional: get reports on Telegram ---------------------------------------
# Create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_CHAT_ID=
