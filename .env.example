# --- JARVIS's brain ------------------------------------------------------------
# pro    = your Claude Pro/Max plan, through Claude Code on this laptop (no extra cost)
# api    = an Anthropic API key (pay as you go)
# gemini = Google Gemini free tier
JARVIS_BRAIN=pro
# Claude model on your plan: haiku (fastest, lightest on your limits) | sonnet | opus (heaviest)
JARVIS_PRO_MODEL=haiku
# Routines (briefs, inbox sweep, night shift) run on Gemini when a key is set, to spare your Claude plan.
JARVIS_AUTOMATION_BRAIN=auto
# Free backup brain + saver mode. Key from https://aistudio.google.com/apikey (Google account, no card needed)
GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-flash-latest
# Give any agent its OWN brain and model (optional). Brains: pro | api | gemini. Models on your plan: haiku | sonnet | opus
# e.g. a smarter model just for emails and career, the fastest one for quick stuff:
# JARVIS_BRAIN_HERALD=pro
# JARVIS_MODEL_HERALD=sonnet
# JARVIS_MODEL_ZEUS=sonnet
# JARVIS_BRAIN_STEVE=gemini
# Only if you choose JARVIS_BRAIN=api:
ANTHROPIC_API_KEY=

# --- About you -------------------------------------------------------------
JARVIS_OWNER_NAME=Sir
# any IANA zone, e.g. Europe/London, America/New_York
JARVIS_TIMEZONE=Africa/Lagos

# --- Engine ----------------------------------------------------------------
JARVIS_MODEL=claude-opus-5-5
JARVIS_PORT=7334
# off = no automatic jobs
JARVIS_SCHEDULER=on

# --- Daily routine (24h, local time) -----------------------------------------
JARVIS_MORNING_AT=07:00
JARVIS_EVENING_AT=21:00
JARVIS_NIGHT_SHIFT_AT=02:00
# Sundays
JARVIS_WEEKLY_AT=18:00
JARVIS_WATCH_EVERY_HOURS=6

# --- How much the agents may do on their own ---------------------------------
#   approve = every message to another person waits for your OK   (start here)
#   trusted = contacts you mark as trusted get messages automatically
#   full    = everything goes out automatically
# Laptop terminal commands ALWAYS wait for your OK (unless JARVIS_SHELL=auto).
JARVIS_AUTONOMY=approve
# Banking is always blocked. Add more words agents must never touch (comma separated):
JARVIS_BLOCK_WORDS=

# --- Telegram: your phone remote control (recommended) -----------------------
# 1. In Telegram, open @BotFather, send /newbot, pick a name. Copy the token it gives you here.
# 2. Start JARVIS, open your new bot in Telegram and send:  /start <code>
#    (the code is shown in the black window and in the dashboard's Autopilot tab)
JARVIS_TELEGRAM_BOT_TOKEN=

# --- JARVIS on your phone (app) ------------------------------------------------
# PIN to unlock the app from your phone (any 4-8 digits; not needed on the laptop itself)
JARVIS_PIN=
# Your app address from Tailscale, e.g. https://zenbook.tail1234.ts.net  (see README: "JARVIS on your phone")
JARVIS_APP_URL=

# --- Urgent phone calls (optional, Twilio, paid: ~US$1-2/month + a few cents per call) --------
# Your mobile in international format, e.g. +6591234567
JARVIS_OWNER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# At night only "critical" things ring; "urgent" ones wait for the morning (Telegram still gets them)
JARVIS_QUIET_HOURS=23:00-07:00
JARVIS_CALL_GAP_MINUTES=20

# --- Weekly money report from your bank's e-mail alerts (needs e-mail set up below) ---
JARVIS_MONEY_WEEKLY_AT=19:00

# --- WhatsApp: OFF and not recommended ----------------------------------------
# Uses an unofficial link to your personal account; WhatsApp can ban numbers for automation.
JARVIS_WHATSAPP=off
JARVIS_OWNER_WHATSAPP=

# --- E-mail: agents read your inbox and send from your account ---------------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
JARVIS_SMTP_HOST=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_IMAP_HOST=imap.gmail.com
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_REPORT_EMAIL_TO=
JARVIS_EMAIL_SIGNATURE=
JARVIS_INBOX_SWEEP_MINUTES=180

# --- Voice: agents talk to you -------------------------------------------------
# Voices: auto = ElevenLabs if a key is set, otherwise free natural voices (JARVIS British, FRIDAY Irish, ...)
JARVIS_TTS=auto
# Agents speak up on their own (briefs, reminders, ideas, alerts) on the laptop and as Telegram voice notes
JARVIS_PROACTIVE_VOICE=on
JARVIS_TELEGRAM_VOICE=on
# Change one agent's free voice, e.g. JARVIS_EDGE_VOICE_JARVIS=en-GB-ThomasNeural

# --- Voice --------------------------------------------------------------------
# Hands-free: click 👂 in the dashboard, then say "Jarvis, ..." (or any agent's name: "Friday, ...").
JARVIS_WAKE_WORDS=jarvis,hey jarvis,ok jarvis
# Fast mode: replies are written ~2.5x faster, but every reply costs twice as much.
JARVIS_FAST_MODE=off
# Telegram voice notes are transcribed on your laptop: tiny | base | small (better with accents, slower)
JARVIS_WHISPER_MODEL=base

# --- Optional: premium custom voices (ElevenLabs) -----------------------------
# Get a key at https://elevenlabs.io (Profile > API keys). Without it, the dashboard uses your computer's voices,
# which you can still customise per agent with the 🎚 Voices button.
ELEVENLABS_API_KEY=
# Give any agent a different voice (voice ID from the ElevenLabs Voice Library, or your own cloned voice):
# JARVIS_VOICE_JARVIS=onwK4e9ZLuTAKqWW03F9
# JARVIS_VOICE_FRIDAY=XB0fDUnXU5powFLqSrS8

# --- Optional: Android phone control (same Wi-Fi as the laptop) ---------------
# OPPO / ColorOS: Settings > About device > Version > tap "Build number" 7 times.
# Then Settings > Additional settings > Developer options > Wireless debugging (turn on).
# Put the IP address & port shown on the Wireless debugging screen here, e.g. 192.168.1.23:41235
JARVIS_PHONE_ADB=
# Where adb.exe is, if it isn't on your PATH (Windows):
JARVIS_ADB=C:\platform-tools\adb.exe

